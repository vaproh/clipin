# API Configuration
PORT=8080
ENV=development
API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,https://clipin.in

# Database Configuration
DATABASE_URL=postgres://clipin:clipin_dev_pass@localhost:5433/clipin_dev?sslmode=disable
POSTGRES_USER=clipin
POSTGRES_PASSWORD=clipin_dev_pass
POSTGRES_DB=clipin_dev
POSTGRES_PORT=5433

# Redis Configuration
REDIS_URL=redis://localhost:6380/0
REDIS_HOST=localhost
REDIS_PORT=6380

# Verifier Service Configuration
VERIFIER_PORT=8081
VERIFIER_ENV=development
VERIFIER_API_KEY=change-me-in-production

# Frontend Configuration
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_PUBLIC_VERIFIER_BASE=http://localhost:8081
NUXT_PUBLIC_SITE_URL=https://clipin.in

# Clerk Authentication Configuration
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample
NUXT_CLERK_SECRET_KEY=sk_test_sample
# JWKS endpoint used by the API to verify Clerk JWTs
# Format: https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Leave empty in development to skip auth verification
CLERK_JWKS_URL=

# Razorpay Webhook (disabled until keys exist)
RAZORPAY_WEBHOOK_SECRET=

# E2E Testing (set to 'true' to disable Clerk module for Playwright tests)
# E2E_TEST=true
