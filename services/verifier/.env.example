# ClipIN Verifier Service Configuration

# Server
VERIFIER_PORT=8081
VERIFIER_ENV=development

# Main API connection
VERIFIER_API_BASE=http://localhost:8080
VERIFIER_API_KEY=

# Polling
VERIFIER_POLL_INTERVAL=15m
VERIFIER_BATCH_SIZE=20

# HTTP client
VERIFIER_HTTP_TIMEOUT=30s

# YouTube Data API v3 key (optional, required for YouTube verification)
YOUTUBE_API_KEY=
